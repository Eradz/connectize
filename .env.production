# Connectize Frontend Production Environment Configuration

# Base URL for the Django API in production
VITE_API_BASE_URL=https://about.connectize.co

# Additional API Configuration
VITE_API_URL=https://about.connectize.co
VITE_APP_API_URL=https://about.connectize.co

# WebSocket Configuration for production  
VITE_WS_URL=wss://about.connectize.co

# Application Configuration
VITE_APP_NAME=Connectize
VITE_APP_VERSION=2.0.0
VITE_FRONTEND_URL=https://connectize.co

# Environment
VITE_APP_ENV=production

# Debug Configuration (disabled in production)
VITE_DEBUG=false
VITE_LOG_LEVEL=warn

# Enterprise Features
VITE_ENTERPRISE_ENABLED=true
VITE_PREMIUM_FEATURES=true

