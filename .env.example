# Frontend environment variables
# Copy this file to `.env` and adjust values for your environment

# Base URL for the Django API (trailing path included)
# Example (local): http://127.0.0.1:8000/api
# Example (prod): https://api.yourdomain.com/api
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Feature Flags
REACT_APP_ENABLE_STRIPE_PAYMENTS=true
REACT_APP_ENABLE_BILLING_MANAGEMENT=true

# Debug Settings
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info
