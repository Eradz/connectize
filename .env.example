# Frontend environment variables
# Copy this file to `.env` and adjust values for your environment

# Origin of the Django API - no trailing path. Request paths already start with
# `api/`, so adding it here yields /api/api/... and every call 404s.
# Example (local): http://localhost:8000
# Example (prod):  https://about.connectize.co
#
# Leave this unset for local development: the app already defaults to
# http://localhost:8000 in dev and https://about.connectize.co in production.
# Setting it overrides both.
VITE_API_BASE_URL=https://about.connectize.co

# Optional city lookup key for api.countrystatecity.in
VITE_COUNTRY_STATE_CITY_API_KEY=

# Stripe Configuration
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Feature Flags
REACT_APP_ENABLE_STRIPE_PAYMENTS=true
REACT_APP_ENABLE_BILLING_MANAGEMENT=true

# Debug Settings
REACT_APP_DEBUG_MODE=false
REACT_APP_LOG_LEVEL=info
