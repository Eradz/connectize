{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "framework": null,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    },
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/signup/login",
      "destination": "/login",
      "permanent": true
    },
    {
      "source": "/signup/signup",
      "destination": "/signup",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/(.*)",
      "destination": "/.well-known/$1"
    },
    {
      "source": "/posts/(.*)",
      "destination": "/api/render-meta?path=/posts/$1"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/render-meta?path=/products/$1"
    },
    {
      "source": "/services/(.*)",
      "destination": "/api/render-meta?path=/services/$1"
    },
    {
      "source": "/company/(.*)",
      "destination": "/api/render-meta?path=/company/$1"
    },
    {
      "source": "/co/(.*)",
      "destination": "/api/render-meta?path=/co/$1"
    },
    {
      "source": "/knowledge/articles/(.*)",
      "destination": "/api/render-meta?path=/knowledge/articles/$1"
    },
    {
      "source": "/knowledge/forums/(.*)",
      "destination": "/api/render-meta?path=/knowledge/forums/$1"
    },
    {
      "source": "/knowledge/topics/(.*)",
      "destination": "/api/render-meta?path=/knowledge/topics/$1"
    },
    {
      "source": "/knowledge/categories/(.*)",
      "destination": "/api/render-meta?path=/knowledge/categories/$1"
    },
    {
      "source": "/knowledge/tags/(.*)",
      "destination": "/api/render-meta?path=/knowledge/tags/$1"
    },
    {
      "source": "/workforce/jobs/(.*)",
      "destination": "/api/render-meta?path=/workforce/jobs/$1"
    },
    {
      "source": "/professionals/(.*)",
      "destination": "/api/render-meta?path=/professionals/$1"
    },
    {
      "source": "/workforce/events/(.*)",
      "destination": "/api/render-meta?path=/workforce/events/$1"
    },
    {
      "source": "/marketplace/listing/(.*)",
      "destination": "/api/render-meta?path=/marketplace/listing/$1"
    },
    {
      "source": "/bidding/projects/(.*)",
      "destination": "/api/render-meta?path=/bidding/projects/$1"
    },
    {
      "source": "/deal-rooms/(.*)",
      "destination": "/api/render-meta?path=/deal-rooms/$1"
    },
    {
      "source": "/logistics/providers/(.*)",
      "destination": "/api/render-meta?path=/logistics/providers/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://about.connectize.co/sitemap.xml"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
