require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '14.0'
# Use static frameworks to improve module stability (prevents intermittent module 'Cordova' not found during verify-module)
use_frameworks! :linkage => :static

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
# Enable input/output path optimization (was disabled previously)
install! 'cocoapods'

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorSplashScreen', :path => '../../node_modules/@capacitor/splash-screen'
  pod 'CapacitorStatusBar', :path => '../../node_modules/@capacitor/status-bar'
end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)

  puts "[post_install] Global pre-clean of sandbox frameworks (extended attributes + AppleDouble)..."
  system <<~CLEAN
    find '#{installer.sandbox.root}' -name '*.framework' -print0 | \
      xargs -0 -I{} bash -c 'xattr -cr "{}" 2>/dev/null || true; find "{}" -name "._*" -delete 2>/dev/null || true'
  CLEAN

  # Removed per-target clean script phases; relying on global pre-clean only to eliminate sandbox warnings.

  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      # Keep sandboxing default (do not force NO) so Xcode can schedule phases normally
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['SWIFT_PRECOMPILE_BRIDGING_HEADER'] = 'NO'
      config.build_settings['SWIFT_DISABLE_SAFETY_CHECKS'] = 'NO'
      config.build_settings['SWIFT_OPTIMIZATION_LEVEL'] = '-Onone'
  config.build_settings['SWIFT_SUPPRESS_WARNINGS'] = 'YES'
  config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'YES'
    end
  end
end
