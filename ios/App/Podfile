require_relative '../../node_modules/@capacitor/ios/scripts/pods_helpers'

platform :ios, '13.0'
# Use static frameworks to improve module stability (prevents intermittent module 'Cordova' not found during verify-module)
use_frameworks! :linkage => :static

# workaround to avoid Xcode caching of Pods that requires
# Product -> Clean Build Folder after new Cordova plugins installed
# Requires CocoaPods 1.6 or newer
install! 'cocoapods', :disable_input_output_paths => true

def capacitor_pods
  pod 'Capacitor', :path => '../../node_modules/@capacitor/ios'
  pod 'CapacitorCordova', :path => '../../node_modules/@capacitor/ios'

end

target 'App' do
  capacitor_pods
  # Add your Pods here
end

post_install do |installer|
  assertDeploymentTarget(installer)

  # Suppress noisy framework header include style warnings coming from upstream Capacitor/Cordova headers
  installer.pods_project.targets.each do |t|
    t.build_configurations.each do |config|
      # Ensure modules enabled
      config.build_settings['CLANG_ENABLE_MODULES'] = 'YES'
      # Silence quoted include in framework header warnings
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
    end
  end

  # Fix [CP] Copy Pods Resources build phase to prevent sandbox permission errors
  # and eliminate warning about missing output dependencies
  require 'xcodeproj'
  
  app_project_path = installer.sandbox.root.parent + 'App.xcodeproj'
  app_project = Xcodeproj::Project.open(app_project_path)
  
  app_project.targets.each do |target|
    next unless target.name == 'App'
    
    target.shell_script_build_phases.each do |phase|
      next unless phase.name == '[CP] Copy Pods Resources'
      
      # Replace the shell script with a simple inline version that doesn't access external files
      phase.shell_script = "# No resources to copy for this project\necho \"No Pods resources to copy\" > \"${SCRIPT_OUTPUT_FILE_0}\"\n"
      
      # Add proper input and output paths to prevent unnecessary execution
      phase.input_paths = ["${PODS_PODFILE_DIR_PATH}/Podfile.lock"]
      phase.output_paths = ["$(DERIVED_FILE_DIR)/Pods-App-resources-${CONFIGURATION}.txt"]
      
      puts "Fixed [CP] Copy Pods Resources build phase for App target"
    end
  end
  
  app_project.save
end
